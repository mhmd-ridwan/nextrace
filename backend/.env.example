# NEXTRACE Environment Configuration
# Copy to .env and adjust values

# Application
APP_NAME=NEXTRACE
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./nextrace.db

# Security
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Alias Configuration
ALIAS_DOMAIN=nextrace-alias.test
ALIAS_PROVIDER=plus_addressing

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp

# Evidence Storage
EVIDENCE_STORAGE_PATH=./evidence_store
REPORTS_PATH=./reports

# External Integrations (optional)
# BREACH_API_KEY=
# BREACH_API_URL=
# SOCIAL_API_KEY=
